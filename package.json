{
  "name": "scriptify-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright test automation tool with recording, enhancement, and reporting capabilities",
  "main": "backend/server.cjs",
  "keywords": [
    "playwright",
    "test-automation",
    "python",
    "pom",
    "allure",
    "jenkins"
  ],
  "author": "Vishal Singh",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node backend/server.cjs",
    "start:bridge": "node backend/cliBridge.js",
    "start:all": "bash scripts/start-servers.sh",
    "stop": "node scripts/stop-server.js",
    "stop:all": "bash scripts/stop-all-servers.sh",
    "dev": "NODE_ENV=development node backend/server.cjs",
    "test": "npm run clean:cache && python scripts/run_tests.py",
    "test:headless": "python scripts/run_tests.py --headless",
    "test:debug": "python scripts/run_tests.py --debug",
    "test:parallel": "python scripts/run_tests.py --parallel 4",
    "test:firefox": "python scripts/run_tests.py --browser firefox",
    "test:webkit": "python scripts/run_tests.py --browser webkit",
    "test:video": "python scripts/run_tests.py --video",
    "test:screenshots": "python scripts/run_tests.py --screenshots",
    "test:analytics": "node scripts/test-analytics.cjs",
    "lint": "eslint backend/ --ext .js,.cjs",
    "lint:fix": "eslint backend/ --ext .js,.cjs --fix",
    "format": "prettier --write backend/",
    "clean": "rm -rf allure-results allure-report screenshots videos logs",
    "clean:cache": "find . -type d -name '__pycache__' -not -path './venv/*' -exec rm -rf {} + 2>/dev/null || true && find . -type f -name '*.pyc' -not -path './venv/*' -delete 2>/dev/null || true && find . -type d -name '.pytest_cache' -not -path './venv/*' -exec rm -rf {} + 2>/dev/null || true && find . -type f -name '.coverage' -not -path './venv/*' -delete 2>/dev/null || true && echo '✅ Cache cleaned'",
    "clean:all": "npm run clean && npm run clean:cache && rm -rf node_modules package-lock.json",
    "setup": "bash scripts/setup.sh",
    "build:extension": "cd frontend && zip -r ../scriptify-ai-extension.zip .",
    "validate": "npm run lint && python scripts/run_tests.py --collect-only"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "openai": "^6.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vishalsingh/scriptify-ai.git"
  },
  "bugs": {
    "url": "https://github.com/vishalsingh/scriptify-ai/issues"
  },
  "homepage": "https://github.com/vishalsingh/scriptify-ai#readme"
}
